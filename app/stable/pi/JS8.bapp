BAPP=4.0
ID=JS8
Name=JS8Call
Comment='Weak Signal Digital Mode'
Ver=Update:1
localVer=0


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# files.js8call.com is gone and upstream publishes no aarch64 binary.
	# Arch: js8call comes from the AUR (yay builds it from source).
	if ! hash rigctl 2>/dev/null; then
		# subshell so HAMLIB's INSTALL/VERSION do not replace ours
		( source "${BAPDIR}/app/stable/pi/HAMLIB.bapp" && INSTALL )
	fi
	if bap_pkg_install js8call; then
		return 0
	fi
	bap_unsupported JS8Call "js8call could not be installed from pacman or the AUR (yay)." \
		"Install yay (see ARCH.md) and retry; upstream ships no aarch64 binary."
}


VERSION(){
	if hash js8call 2>/dev/null; then
		CURRENT=$(bap_pkg_version js8call | sed 's/[+-].*//')
		[ -z "$CURRENT" ] && CURRENT=1
	else
		CURRENT=0
	fi
	NEWVER=$(bap_pkg_candidate js8call | sed 's/[+-].*//')
	[ -z "$NEWVER" ] && NEWVER=$CURRENT
}

REMOVE(){
	bap_pkg_remove js8call 2>/dev/null || true
	sudo rm -f /usr/local/bin/js8call /usr/local/bin/js8 /usr/share/applications/js8call.desktop
}
