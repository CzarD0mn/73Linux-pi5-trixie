BAPP=4.0
ID=FLDIGI
Name=fldigi
Comment='Digital Comms Software'
Ver=Update:4.1.23
localVer=0


INSTALL(){
	if [ -f "${BAPDIR}/bin/trixie-apt.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/trixie-apt.sh"
	fi

	w1hkj_latest() {
		local name="$1"
		local dest="${BUILDDIR:-.}"
		if declare -F bap_download_w1hkj >/dev/null; then
			bap_download_w1hkj "$name" "$dest"
			return $?
		fi
		local tar
		tar=$(curl -fsSL --max-time 20 "https://www.w1hkj.org/files/${name}/" \
			| grep -oE "${name}-[0-9]+(\.[0-9]+)*\.tar\.gz" | sort -V | tail -1)
		[ -n "$tar" ] || return 1
		wget -q --tries 2 --connect-timeout=60 -O "${dest}/${tar}" \
			"https://www.w1hkj.org/files/${name}/${tar}" || return 1
		echo "$tar"
	}



	CLEANSOURCE(){
		#this function removes any old source files before
		#new files are downloaded for installation. This
		#function is called by install functions below.
		PACKAGE=$(ls ${HOME}/.bap-source-files | grep ${PACKAGE})
		echo "package is $PACKAGE"
		if [ -z $PACKAGE ]; then
			echo "no old package found"
		else
			if [ -d ${HOME}/.bap-source-files/${PACKAGE} ]; then
		   		echo "Dir to remove is ${HOME}/.bap-source-files/${PACKAGE}/"
		   		rm -rf ${HOME}/.bap-source-files/${PACKAGE}/
			fi
		fi
	}

	##################################
	#	DEPENDS
	##################################
	#install needed depends
	#check to see if 32 or 64 bit to detemine correct dependency
	if [ `getconf LONG_BIT` = '64' ]; then
	LIBJPG=libjpeg62-turbo-dev
	if ! apt-cache show libjpeg62-turbo-dev >/dev/null 2>&1; then LIBJPG=libjpeg-dev; fi
	else
	LIBJPG=libjpeg9-dev
	if ! apt-cache show libjpeg9-dev >/dev/null 2>&1; then LIBJPG=libjpeg-dev; fi
	fi
	sudo apt-get install -y build-essential pkg-config libfltk1.3-dev $LIBJPG libxft-dev libxinerama-dev libxcursor-dev libsndfile1-dev libsamplerate0-dev portaudio19-dev libpulse-dev libusb-1.0-0-dev texinfo libudev-dev
	mkdir -p "${BUILDDIR}"
	cd "${BUILDDIR}" || return

	FLX=$(ldconfig -p | grep flxmlrpc || true)
	if [ -z "$FLX" ]; then
		FLXM=$(w1hkj_latest flxmlrpc) || return
		FLXM=$(basename "${FLXM}" | tr -d '\r' | tail -1)
		tar -xzf "${BUILDDIR}/${FLXM}"
		XMPKG=$(tar -tzf "${BUILDDIR}/${FLXM}" | head -1 | cut -d/ -f1)
		cd "${BUILDDIR}/${XMPKG}" || return
		./configure --prefix=/usr/local --enable-static
		make -j "${BAPCORE:-$(nproc)}"
		sudo make install
		sudo ldconfig
		cd "${BUILDDIR}"
		rm -f "${BUILDDIR}/${FLXM}"
	fi
	PACKAGE=fldigi
	CLEANSOURCE
	cd "${BUILDDIR}" || return
	# Download and unpack in the same directory. Do not capture wget noise.
	FLTAR=$(w1hkj_latest fldigi) || return
	FLTAR=$(basename "${FLTAR}" | tr -d '\r' | grep -E '^fldigi-[0-9].*\.tar\.gz$' | tail -1)
	if [ -z "$FLTAR" ] || [ ! -f "${BUILDDIR}/${FLTAR}" ]; then
		FLTAR=$(ls -1 "${BUILDDIR}"/fldigi-*.tar.gz 2>/dev/null | tail -1)
		FLTAR=$(basename "${FLTAR}")
	fi
	if [ ! -f "${BUILDDIR}/${FLTAR}" ]; then
		echo "ERROR: fldigi tarball not found in ${BUILDDIR}"
		return 1
	fi
	echo "Unpacking ${FLTAR}"
	tar -xzf "${BUILDDIR}/${FLTAR}"
	FLPKG=$(tar -tzf "${BUILDDIR}/${FLTAR}" | head -1 | cut -d/ -f1)
	cd "${BUILDDIR}/${FLPKG}" || return
	./configure --prefix=/usr/local --enable-static
	make -j "${BAPCORE:-$(nproc)}"
	sudo make install
	sudo ldconfig
	rm -f "${BUILDDIR}/${FLTAR}"
}


VERSION(){
		if ! hash fldigi 2>/dev/null; then
			CURRENT=0
			NEWVER=$(curl --max-time 20 -s https://sourceforge.net/projects/fldigi/files/fldigi/ | grep .tar.gz | head -1 | awk -F "-" '{print $2}' | awk -F ".tar.gz" '{print $1}')
		else		
			CURRENT=$(fldigi --version | head -1 | sed 's/fldigi //')
			NEWVER=$(curl --max-time 20 -s https://sourceforge.net/projects/fldigi/files/fldigi/ | grep .tar.gz | head -1 | awk -F "-" '{print $2}' | awk -F ".tar.gz" '{print $1}')
		fi
}

REMOVE(){
	DIR=$(ls $BUILDDIR | grep fldigi)
	cd ${BUILDDIR}/${DIR}
	sudo make uninstall
}