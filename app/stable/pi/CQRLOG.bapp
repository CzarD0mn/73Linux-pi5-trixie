BAPP=4.0
ID=CQRLOG
Name=CQRLOG
Comment='Logging Software'
Ver=Update:2.5.2
localVer=0


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# Arch: cqrlog from the AUR via yay; source build with pacman's Lazarus
	# as a fallback.
	if bap_pkg_available cqrlog; then
		bap_pkg_install cqrlog
		return $?
	fi

	echo "cqrlog package not installable; building from source with the distro Lazarus"
	bap_pkg_install_available git build-essential lazarus lcl-gtk2 fpc fp-units-misc \
		libssl-dev libmariadb-dev-compat default-mysql-client-core default-mysql-server \
		default-mysql-server-core libnetpbm11 || return 1
	rm -rf "${BUILDDIR}/cqrlog"
	mkdir -p "${BUILDDIR}"
	cd "${BUILDDIR}" || return 1
	git clone https://github.com/ok2cqr/cqrlog.git || return 1
	cd "${BUILDDIR}/cqrlog" || return 1
	make || return 1
	sudo make install
}


VERSION(){

	lastrelease() {
		git ls-remote --tags https://github.com/ok2cqr/cqrlog | cut -d/ -f3- | tail -n1 | sed 's/v//'
	 }

	if ! hash cqrlog 2>/dev/null; then
		CURRENT=0
		NEWVER=$(lastrelease)
	else
		CURRENT=$(cqrlog --version | awk '{print $2}' | sed 's/Ver://')
		NEWVER=$(lastrelease)
	fi
}

REMOVE(){
	if bap_pkg_installed cqrlog; then
		bap_pkg_remove cqrlog
	else
		sudo rm -rf /usr/share/cqrlog
		sudo rm -f /usr/bin/cqrlog
		sudo rm -f /usr/share/applications/cqrlog.desktop
	fi
}
