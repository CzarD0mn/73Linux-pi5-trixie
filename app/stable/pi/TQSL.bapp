BAPP=4.0
ID=TQSL
Name=tqsl
Comment='Log Book of the World'
Ver=Update:1
localVer=0


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# Arch: trustedqsl from the AUR via yay. The ARRL source build with pacman
	# deps (db, wxwidgets-gtk3, openssl, curl, expat, sqlite) is the fallback.
	if bap_pkg_install trustedqsl; then
		return 0
	fi
	echo "trustedqsl package install failed; building from ARRL source"
	bap_pkg_install base-devel cmake expat openssl db curl wxwidgets-gtk3 sqlite zlib || return 1
	mkdir -p "${BUILDDIR}"
	cd "${BUILDDIR}" || return 1
	rm -rf "${BUILDDIR}"/tqsl-*
	CUR=$(curl -fsSL --max-time 30 https://www.arrl.org/tqsl-download | grep -oE 'TQSL [0-9.]+ for Linux' | head -1 | awk '{print $2}')
	[ -n "$CUR" ] || { echo "ERROR: could not find TQSL version on arrl.org" >&2; return 1; }
	wget --tries 2 --connect-timeout=60 "https://www.arrl.org/tqsl/tqsl-${CUR}.tar.gz" || return 1
	tar -xzf "tqsl-${CUR}.tar.gz" && rm -f "tqsl-${CUR}.tar.gz"
	cd "tqsl-${CUR}" || return 1
	cmake . && make -j "${BAPCORE:-$(nproc)}" && sudo make install
}


VERSION(){
	if ! hash tqsl 2>/dev/null; then
		CURRENT=0
		NEWVER=1
	else
		CURRENT=1
		NEWVER=1
	fi
}

REMOVE(){
	if bap_pkg_installed trustedqsl; then
		bap_pkg_remove trustedqsl
	fi
	sudo rm -f /usr/local/bin/tqsl /usr/share/applications/tqsl.desktop
}
