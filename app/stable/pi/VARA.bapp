BAPP=4.0
ID=VARA
Name=vara
Comment='vara modem'
Ver=
localVer=0


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# VARA is a Windows program. On Raspberry Pi it is installed through
	# Pi-Apps (Box64/Box86 + Wine), and Pi-Apps only supports Debian-based
	# systems. There is no pacman/AUR path for it on Arch Linux ARM.
	bap_unsupported VARA "VARA needs Pi-Apps (Box86/Box64 + Wine), which is Debian-only." \
		"No Arch Linux ARM / AUR route exists. Run VARA on a Windows or" \
		"Debian/Raspberry Pi OS machine instead."
	return 1
}

VERSION(){

	if [ -d ${HOME}/.wine/drive_c/VARA ]; then
		CURRENT=1
		NEWVER=1
	else
		CURRENT=0
		NEWVER=1
	fi
}

REMOVE(){
echo
echo "##########################################"
echo "Remove not available at this time for $ID"
echo "##########################################"
sleep 4
}
