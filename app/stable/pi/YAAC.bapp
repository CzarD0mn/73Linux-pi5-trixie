BAPP=4.0
ID=YAAC
Name=YAAC
Comment='Yet Another APRS Client'
Ver=Update:
localVer=0


INSTALL(){
	if [ -f "${BAPDIR}/bin/trixie-apt.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/trixie-apt.sh"
	fi

	# openjdk-10-dbg has not existed in Debian for years and made the whole
	# apt line fail on Trixie. Use default-jre (OpenJDK 21 on Trixie).
	mkdir -p "${BUILDDIR}"
	cd "${BUILDDIR}" || return 1
	rm -f YAAC.zip
	wget --tries 2 --connect-timeout=60 https://www.ka2ddo.org/ka2ddo/YAAC.zip || return 1
	bap_apt_install_available librxtx-java default-jre unzip
	mkdir -p "${HOME}/YAAC"
	cd "${HOME}/YAAC" || return 1
	#Fix issue 375 to prevent YAAC from reopening
	rm -f "${HOME}/YAAC/YAAC"
	cat >YAAC <<EOF
#!/bin/bash
java -jar ${HOME}/YAAC/YAAC.jar
EOF
	chmod +x YAAC
	cat >yaac.desktop <<EOF
[Desktop Entry]
Name=YAAC
GenericName=YAAC
Comment=APRS Client
Exec=${HOME}/YAAC/YAAC
Icon=${BAPDIR}/data/ico/YAAC.png
Terminal=false
Type=Application
Categories=Network;HamRadio;
EOF
	sudo mv yaac.desktop /usr/share/applications/
	mv "${BUILDDIR}/YAAC.zip" "$HOME/YAAC/"
	unzip -o "${HOME}/YAAC/YAAC.zip"
	rm -f "$HOME/YAAC/YAAC.zip"
}


VERSION(){
	if [ ! -d ${HOME}/YAAC ]; then
		CURRENT=0
		wget -q https://sourceforge.net/projects/yetanotheraprsc/files/YAACBuildLabel.txt -O /run/user/${UID}/latestyaac.txt
		NEWVER=$(cat /run/user/${UID}/latestyaac.txt | sed 's/1.0-beta//;s/(.*//')
	else
		CURRENT=$(java -jar ${HOME}/YAAC/YAAC.jar -version | grep beta | sed 's/.*beta//;s/(.*//')
		wget -q https://sourceforge.net/projects/yetanotheraprsc/files/YAACBuildLabel.txt -O /run/user/${UID}/latestyaac.txt
		NEWVER=$(cat /run/user/${UID}/latestyaac.txt | sed 's/1.0-beta//;s/(.*//')
	fi
}

REMOVE(){
	rm -rf $HOME/YAAC
	sudo rm /usr/share/applications/yaac.desktop
}