BAPP=4.0
ID=GRIDCALC
Name=GridCalc
Comment='Grid Calculation'
Ver=1
localVer=1


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# bc and yad from pacman. "wwl" is not in the Arch repos; install it if a
	# package exists (AUR), otherwise grid-calc downloads it itself.
	bap_pkg_install bc yad || return 1
	bap_pkg_install_available wwl || true
	mkdir -p "${HOME}/bin"
	cd "${HOME}/bin" || return 1
	wget --tries 2 --connect-timeout=60 https://raw.githubusercontent.com/km4ack/pi-scripts/master/grid-calc || return 1
	chmod +x "$HOME/bin/grid-calc"
}


VERSION(){
	if [ -f ${HOME}/bin/grid-calc ]; then
		CURRENT=1
		NEWVER=1
	else
		CURRENT=0
		NEWVER=1
	fi
}

REMOVE(){
	rm ${HOME}/bin/grid-calc
}