BAPP=4.0
ID=WSJTX
Name=WSJTX
Comment='Weak Signal Digital Software'
Ver=Update:2.7.0-rc5
localVer=0


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# Arch: WSJT-X is packaged as "wsjtx" (official repos where built for
	# aarch64, otherwise AUR via yay). Upstream ARM builds are .deb/.rpm only, so they are not used.
	if [ -f /usr/local/bin/wsjtx ]; then
		sudo rm -f /usr/local/bin/wsjtx*
	fi
	bap_pkg_install wsjtx
}


VERSION(){
	if hash wsjtx 2>/dev/null; then
		CURRENT=$(bap_pkg_version wsjtx | sed 's/[-+~].*//')
		[ -z "$CURRENT" ] && CURRENT=1
	else
		CURRENT=0
	fi
	NEWVER=$(curl --max-time 20 -fsSL https://sourceforge.net/projects/wsjt/files/ 2>/dev/null \
		| grep -oE 'wsjtx-[0-9]+\.[0-9]+\.[0-9]+' | sort -uV | tail -1 | sed 's/wsjtx-//')
	[ -z "$NEWVER" ] && NEWVER=$CURRENT
}

REMOVE(){
	bap_pkg_remove wsjtx
}
