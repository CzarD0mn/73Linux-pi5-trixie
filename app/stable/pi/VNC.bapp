BAPP=4.0
ID=VNC
Name=VNC
Comment='VNC Viewer'
Ver=6.22.826
localVer=6.22.826


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# Arch: TigerVNC viewer from the official repos (RealVNC is AUR-only and
	# not built for aarch64).
	bap_pkg_install tigervnc
}


VERSION(){
	PKG=realvnc-vnc-viewer
	bap_pkg_installed "$PKG" || PKG=tigervnc-viewer
	if ! hash vncviewer 2>/dev/null; then
		CURRENT=0
	else
		CURRENT=$(bap_pkg_version "$PKG" | sed 's/[-+].*//')
		[ -z "$CURRENT" ] && CURRENT=1
	fi
	NEWVER=$(bap_pkg_candidate "$PKG" | sed 's/[-+].*//')
	{ [ -z "$NEWVER" ] || [ "$NEWVER" = "(none)" ]; } && NEWVER=$CURRENT
}

REMOVE(){
	bap_pkg_remove realvnc-vnc-viewer tigervnc-viewer 2>/dev/null || true
}
