BAPP=4.0
ID=ARDOPGUI
Name=ardop-gui
Comment='GUI for ARDOP Modem'
Ver=Update:1
localVer=0

# Pi 5 / Trixie fork: use G8BPQ's native aarch64 build (piARDOP_GUI64) on a
# 64-bit userland instead of the 32-bit armhf binary. The binary is still
# installed as ~/ardop/piARDOP_GUI so the menu entry and VERSION are unchanged.

INSTALL(){
	if [ -f "${BAPDIR}/bin/trixie-apt.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/trixie-apt.sh"
	fi

	BASEURL=https://www.cantab.net/users/john.wiseman/Downloads/Beta
	mkdir -p "${HOME}/ardop"
	cd "${HOME}/ardop" || return 1

	if [ "$(getconf LONG_BIT)" = 64 ]; then
		BIN=piARDOP_GUI64
		bap_apt_install libqt5core5a libqt5gui5 libqt5network5 libqt5widgets5
	else
		BIN=piARDOP_GUI
		sudo apt-get install -y libqt5widgets5 libqt5network5
	fi

	rm -f piARDOP_GUI.new
	if ! wget --tries 2 --connect-timeout=60 -O piARDOP_GUI.new "${BASEURL}/${BIN}"; then
		echo "ERROR: could not download ${BASEURL}/${BIN}" >&2
		rm -f piARDOP_GUI.new
		return 1
	fi
	mv -f piARDOP_GUI.new piARDOP_GUI
	chmod +x "${HOME}/ardop/piARDOP_GUI"

	FILE=${HOME}/.config/G8BPQ/ARDOP_GUI.conf
	mkdir -p "${HOME}/.config/G8BPQ"
	touch "${FILE}"
	if ! grep -q '^Port=' "${FILE}"; then
		echo "[General]" >>"${FILE}"
		echo "Host=local" >>"${FILE}"
		echo "Port=8515" >>"${FILE}"
	fi
	MENU
}
MENU(){
	cat >ardopgui.desktop <<EOF
[Desktop Entry]
Name=ARDOP GUI
GenericName=ARDOP GUI
Comment=Graphical User Interface for ARDOP modem
Exec=${HOME}/ardop/piARDOP_GUI
Icon=${BAPDIR}/data/ico/ardop.png
Terminal=false
Type=Application
Categories=Network;HamRadio;
EOF

	sudo mv ardopgui.desktop /usr/share/applications/
}


VERSION(){
if [ ! -f ${HOME}/ardop/piARDOP_GUI ]; then
	CURRENT=0
	NEWVER=1
else
	CURRENT=1
	NEWVER=1

fi
}

REMOVE(){
	if [ -f $HOME/ardop/piARDOP_GUI ]; then
		rm $HOME/ardop/piARDOP_GUI
		sudo rm /usr/share/applications/ardopgui.desktop
	fi
}
