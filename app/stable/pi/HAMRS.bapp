BAPP=4.0
ID=HAMRS
Name=HAMRS
Comment='Logging Software'
Ver=Update:1
localVer=0


INSTALL(){
	if [ -f "${BAPDIR}/bin/trixie-apt.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/trixie-apt.sh"
	fi

	# hamrs.app now publishes a native linux-arm64 AppImage. Use it on 64-bit
	# Pi OS instead of the armv7l build + armhf multiarch stack (which needed
	# libasound2/libgtk-3-0/libglib2.0-0:armhf, all renamed to *t64 on Trixie).
	mkdir -p "${HOME}/Downloads"
	if ls "${HOME}/Downloads"/hamrs-* >/dev/null 2>&1; then
		mkdir -p "$HOME/Downloads/old-hamrs"
		mv "$HOME"/Downloads/hamrs-* "$HOME/Downloads/old-hamrs/"
	fi
	cd "${HOME}/Downloads" || return 1

	if [ "$(getconf LONG_BIT)" = 64 ]; then
		PAT_RE='linux-arm64\.AppImage'
	else
		PAT_RE='linux-armv7l\.AppImage'
	fi
	DL=$(curl -fsSL --max-time 30 https://www.hamrs.app | grep -oE 'https://[^"]+' | grep -E "$PAT_RE" | head -1)
	if [ -z "$DL" ]; then
		echo "ERROR: no HAMRS download matching $PAT_RE on https://www.hamrs.app" >&2
		return 1
	fi
	wget --tries 2 --connect-timeout=60 -O hamrs "${DL}" || return 1
	chmod +x hamrs
	sudo mv hamrs /usr/local/bin/hamrs

	# AppImages need FUSE 2 (libfuse2t64 on Trixie) plus the usual Electron libs.
	bap_apt_install libfuse2 fuse3 libnss3 libgtk-3-0 libasound2 libgbm1 libxss1 libxtst6 libnotify4
	sudo modprobe fuse 2>/dev/null || true

	cat >"${HOME}/Downloads/hamrs.desktop" <<EOF
[Desktop Entry]
Name=HAMRS
Comment=POTA Logging Software
Exec=/usr/local/bin/hamrs --no-sandbox
Icon=/usr/share/pixmaps/hamrs-logo.png
Terminal=false
Type=Application
Categories=HamRadio
EOF
	sudo mv "${HOME}/Downloads/hamrs.desktop" /usr/share/applications/
	wget -q https://github.com/km4ack/pi-scripts/raw/master/hamrs-logo.png -O "$HOME/Downloads/hamrs-logo.png" \
		&& sudo mv "$HOME/Downloads/hamrs-logo.png" /usr/share/pixmaps/hamrs-logo.png
}


VERSION(){
	if [ ! -f /usr/local/bin/hamrs ]; then
		CURRENT=0
		NEWVER=1
	else
		CURRENT=1
		NEWVER=1
	fi
}

REMOVE(){
	sudo rm /usr/local/bin/hamrs
	sudo rm /usr/share/applications/hamrs.desktop
}