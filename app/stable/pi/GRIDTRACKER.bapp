BAPP=4.0
ID=GRIDTRACKER
Name=GridTracker
Comment='Track grids in FT8'
Ver=Update:1.22.1016
localVer=1.22.1010


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# GridTracker 2 publishes an official aarch64 Arch package (.pacman);
	# install it with pacman -U.
	GT_PAGE=https://gridtracker.org/index.php/downloads/gridtracker-downloads
	if [ "$(getconf LONG_BIT)" != 64 ]; then
		bap_unsupported GridTracker "GridTracker 2 only publishes arm64 (64-bit) Linux builds."
		return 1
	fi
	GTURL=$(curl -fsSL -A "Mozilla/5.0" --max-time 30 "$GT_PAGE" \
		| grep -oE 'https://download2\.gridtracker\.org/GridTracker2-[0-9.]+-aarch64\.pacman' | sort -V | tail -1)
	if [ -z "$GTURL" ]; then
		echo "ERROR: could not find the GridTracker2 aarch64 .pacman package on $GT_PAGE" >&2
		return 1
	fi
	mkdir -p "${BUILDDIR}"
	cd "${BUILDDIR}" || return 1
	GTPKG=${GTURL##*/}
	wget --tries 2 --connect-timeout=60 -O "$GTPKG" "$GTURL" || return 1
	sudo pacman -U --needed --noconfirm "${BUILDDIR}/${GTPKG}" || return 1
	rm -f "$GTPKG"

	# Retire the GridTracker 1.x install made by upstream 73Linux / BAP.
	if [ -d "$HOME/GridTracker" ]; then
		mv "$HOME/GridTracker" "$HOME/GridTracker.old.$(date +%Y%m%d%H%M%S)"
	fi
	sudo rm -f /usr/share/applications/gridtracker.desktop
}


VERSION(){
	GTNAME=$(pacman -Qq 2>/dev/null | grep -iE '^gridtracker2?$' | head -1)
	if [ -n "$GTNAME" ]; then
		CURRENT=$(bap_pkg_version "$GTNAME" | sed 's/-.*//')
	else
		CURRENT=0
	fi
	NEWVER=$(curl --max-time 20 -fsSL -A "Mozilla/5.0" https://gridtracker.org/index.php/downloads/gridtracker-downloads 2>/dev/null \
		| grep -oE 'GridTracker2-[0-9.]+-aarch64\.pacman' | sort -V | tail -1 | sed 's/GridTracker2-//;s/-aarch64.pacman//')
	[ -z "$NEWVER" ] && NEWVER=$CURRENT
}

REMOVE(){
	for p in $(pacman -Qq 2>/dev/null | grep -iE '^gridtracker2?$'); do sudo pacman -R --noconfirm "$p"; done
	rm -rf "${HOME}/GridTracker"
	sudo rm -f /usr/share/applications/gridtracker.desktop
}
