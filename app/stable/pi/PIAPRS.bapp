BAPP=4.0
ID=PIAPRS
Name=Pi-APRS
Comment='APRS Messaging Client'
Ver=1
localVer=1


INSTALL(){
	if [ -f "${BAPDIR}/bin/arch-pkg.sh" ]; then
		# shellcheck disable=SC1091
		source "${BAPDIR}/bin/arch-pkg.sh"
	fi

	# Upstream's desktop entry was written to /run/user/$UID, which does not
	# exist when 73Linux runs over SSH without a graphical session.
	bap_pkg_install git yad || return 1
	if [ -d "${HOME}/Pi-APRS" ]; then
		rm -rf "${HOME}/Pi-APRS"
	fi
	cd "${HOME}" || return 1
	git clone https://github.com/km4ack/Pi-APRS.git || return 1
	mkdir -p "${HOME}/.local/share/applications"
	cat <<EOF > "${HOME}/.local/share/applications/piaprs.desktop"
[Desktop Entry]
Name=Pi-APRS
GenericName=Pi-APRS by KM4ACK
Comment=APRS Messaging
Exec=${HOME}/Pi-APRS/pi-aprs
Icon=${BAPDIR}/data/ico/aprs.png
Terminal=true
Type=Application
Categories=Network;HamRadio
EOF
	sudo cp "${HOME}/.local/share/applications/piaprs.desktop" /usr/share/applications/
}


VERSION(){
	if [ -d ${HOME}/Pi-APRS ]; then
		CURRENT=1
		NEWVER=1
	else
		CURRENT=0
		NEWVER=1
	fi
}

REMOVE(){
	rm -rf $HOME/Pi-APRS/
	sudo rm /usr/share/applications/piaprs.desktop
}